\n","dt_cv=cross_val_score(dt_model,X,y,cv=5)\n","rf_cv=cross_val_score(rf_model,X,y,cv=5)\n","\n","print(\"\\nCross validation Accuracy:\")\n","print(\"Decision Tree:\",dt_cv.mean())\n","print(\"Random Forest:\",rf_cv.mean())\n","\n","\n","\n"]}]}